data/raw/*
!data/raw/*.dvc
!data/raw/.gitignore
data/processed/
/data/interim/
models/*.pt
models/*.onnx
# poids YOLO téléchargés à la racine (yolo11n.pt) ; aucun .pt n'est versionné
*.pt
mlartifacts/
mlruns/
# dossier de travail Ultralytics
/runs/

# Divers
.vscode/
.DS_Store
# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env.local

# Secrets: never commit
.env
.env.*
!.env.example
mlflow.db
